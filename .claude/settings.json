{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm test)",
      "Bash(pnpm test:*)",
      "Bash(pnpm vitest:*)",
      "Bash(pnpm lint)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm format)",
      "Bash(pnpm format:check)",
      "Bash(pnpm db:reset)",
      "Bash(pnpm db:seed)",
      "Bash(pnpm db:index)",
      "Bash(pnpm eval:schema)",
      "Bash(pnpm eval:retrieval)",
      "Bash(bash scripts/check-secrets.sh:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Edit(./.env)",
      "Bash(cat .env:*)",
      "Bash(git add .env:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  }
}
