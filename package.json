{
  "name": "triage-agent",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:reset": "pnpm --filter @triage/data db:reset",
    "db:seed": "pnpm --filter @triage/data db:seed",
    "eval:schema": "pnpm --filter @triage/evals schema:write",
    "mcp:stdio": "pnpm --filter @triage/mcp-server mcp:stdio",
    "mcp:http": "pnpm --filter @triage/mcp-server mcp:http",
    "eval:retrieval": "pnpm --filter @triage/evals retrieval",
    "db:index": "pnpm --filter @triage/data db:index",
    "db:demo": "pnpm --filter @triage/data db:demo",
    "agent:run": "pnpm --filter @triage/agent agent:run",
    "eval": "pnpm --filter @triage/evals eval",
    "eval:charts": ".venv/bin/python scripts/report.py",
    "eval:labels": "pnpm --filter @triage/evals labels",
    "api:start": "pnpm --filter @triage/api start",
    "api:worker": "pnpm --filter @triage/api worker",
    "api:token": "pnpm --filter @triage/api make-token",
    "triage-failures": "pnpm --filter @triage/evals triage-failures",
    "web:snapshot": "pnpm --filter @triage/api snapshot"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
