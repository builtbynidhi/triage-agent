# Copy to .env. Never commit .env.
# replay (default: recordings only, no API calls) | record-missing (call only when no recording exists)
# | record (re-record everything) | live (call the APIs, no recordings). See packages/providers.
PROVIDER_MODE=replay
# Free tiers only: never add a payment method to either account.
GEMINI_API_KEY=
GROQ_API_KEY=
JWT_SECRET=
DATABASE_PATH=./data/triage.db
TRACE_DIR=./traces
CAPTURE_MESSAGE_CONTENT=false
OTLP_ENDPOINT=              # optional, e.g. Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Optional hosted mode
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Web app (apps/web). Leave unset for the read-only demo snapshot (what Vercel serves).
# Set the first two to read the live API instead; the token stays on the server.
TRIAGE_API_URL=             # e.g. http://127.0.0.1:3200
TRIAGE_API_TOKEN=           # a reviewer token: pnpm api:token --tenant tenant_a --role reviewer
# Lets the web UI approve and reject. The web app has no login: only on a machine you trust.
TRIAGE_WEB_ALLOW_APPROVE=false
