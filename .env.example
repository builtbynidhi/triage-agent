# Copy to .env. Never commit .env.
# replay (default: recordings only, no API calls) | record-missing (call only when no recording exists)
# | record (re-record everything) | live (call the APIs, no recordings). See packages/providers.
PROVIDER_MODE=replay
# Free tiers only: never add a payment method to either account.
GEMINI_API_KEY=
GROQ_API_KEY=
JWT_SECRET=
DATABASE_PATH=./data/triage.db
TRACE_DIR=./traces
CAPTURE_MESSAGE_CONTENT=false
OTLP_ENDPOINT=              # optional, e.g. Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Optional hosted mode
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
